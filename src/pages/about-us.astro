---
import { sanityClient } from 'sanity:client';
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/AboutHero.astro';
import AboutIntro from '../components/AboutIntro.astro';
import { ABOUT_PAGE_QUERY } from '../lib/queries';

const page = await sanityClient.fetch(ABOUT_PAGE_QUERY);
const sections = page?.sections ?? [];

type PageSection = NonNullable<typeof sections>[number];

const PAGE_TITLE = 'About Us | Paprika Advertising';
const PAGE_DESCRIPTION =
  'Paprika Advertising is a Budapest-based Franco-Hungarian company specializing in custom Point of Sale displays. Design, production, and partnership for retail brands.';
---

<Layout title={PAGE_TITLE} description={PAGE_DESCRIPTION}>
  <main>
    {
      sections.length > 0 ? (
        sections.map((section: PageSection) => {
          switch (section._type) {
            case 'aboutHeroSection':
              return (
                <AboutHero
                  headline={section.headline}
                  body={section.body}
                  image={section.image}
                />
              );
            case 'aboutIntroSection':
              return (
                <AboutIntro
                  body={section.body}
                  highlights={section.highlights}
                  ctaLabel={section.ctaLabel}
                />
              );
            default:
              return null;
          }
        })
      ) : (
        <>
          <AboutHero />
          <AboutIntro />
        </>
      )
    }
  </main>
</Layout>
