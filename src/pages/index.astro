---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Paprika">
  <main class="mx-auto max-w-container px-6 py-16">
    <h1 class="font-heading text-4xl text-blue">Paprika</h1>
    <p class="mt-4 text-mid-gray-2">
      Tailwind and Sanity are installed. Create a Sanity project, add your
      project ID to <code class="text-red">.env</code>, then open
      <a class="text-green underline" href="/admin">/admin</a> for Studio.
    </p>
  </main>
</Layout>
