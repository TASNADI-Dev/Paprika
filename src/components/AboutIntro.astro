---
import Button from './Button.astro';
import { localizedPath, t, type Locale } from '../lib/i18n';

interface HighlightItem {
  _key?: string;
  icon?: string | null;
  title?: string | null;
  body?: string | null;
}

interface Props {
  locale?: Locale;
  body?: string | null;
  highlights?: HighlightItem[] | null;
  ctaLabel?: string | null;
}

const ICON_COLORS = ['text-blue', 'text-red', 'text-green'] as const;

const { locale = 'en', body, highlights, ctaLabel } = Astro.props;

const quoteHref = `${localizedPath(locale, '/')}#quote`;

const defaultHighlights = (): HighlightItem[] => [
  {
    _key: 'experience',
    icon: 'ph-fill ph-circle',
    title: t(locale, 'aboutIntro.highlights.experience.title'),
    body: t(locale, 'aboutIntro.highlights.experience.body'),
  },
  {
    _key: 'execution',
    icon: 'ph-fill ph-circle',
    title: t(locale, 'aboutIntro.highlights.execution.title'),
    body: t(locale, 'aboutIntro.highlights.execution.body'),
  },
  {
    _key: 'export',
    icon: 'ph-fill ph-circle',
    title: t(locale, 'aboutIntro.highlights.export.title'),
    body: t(locale, 'aboutIntro.highlights.export.body'),
  },
];

const defaultBody = t(locale, 'aboutIntro.body');

const paragraphs = (body || defaultBody)
  .split(/\n\s*\n/)
  .map((p: string) => p.trim())
  .filter(Boolean);
const items = highlights?.length ? highlights : defaultHighlights();
const buttonLabel = ctaLabel || t(locale, 'aboutIntro.ctaLabel');
---

<section class="bg-light-gray" aria-label={t(locale, 'aboutIntro.ariaLabel')}>
  <div
    class="mx-auto grid max-w-container grid-cols-12 items-start gap-16 px-[6vw] py-24 max-lg:grid-cols-1 max-lg:gap-12 max-md:gap-10 max-md:py-16"
    data-stagger-children
  >
    <div class="col-span-7 space-y-6 text-[1.25rem] leading-relaxed text-mid-gray-2 max-lg:col-span-full">
      {paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>

    <div class="col-span-5 max-lg:col-span-full">
      <ul class="flex flex-col" role="list">
        {
          items.map((item: HighlightItem, index: number) => (
            <li
              class:list={[
                'flex gap-4 py-6',
                index < items.length - 1 && 'border-b border-mid-gray-1/60',
                index === 0 && 'pt-0',
              ]}
            >
              {item.icon && (
                <i
                  class:list={[
                    item.icon,
                    'mt-0.5 size-6 shrink-0 text-[1.5rem] leading-none',
                    ICON_COLORS[index % ICON_COLORS.length],
                  ]}
                  aria-hidden="true"
                />
              )}
              <div>
                <h3 class="font-heading text-xl font-medium tracking-tight text-dark-gray max-md:text-lg">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-mid-gray-2">
                  {item.body}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <Button href={quoteHref} label={buttonLabel} class="mt-8" />
    </div>
  </div>
</section>
