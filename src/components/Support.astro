---
import { asset } from '../lib/assets';

const dspLogoSrc = asset('/home/DSP_logo_vector.svg');
const neumLogoSrc = asset('/home/NEUM_logo_fekete_vector.svg');
---

<section class="bg-white" aria-label="Program support">
  <div class="mx-auto max-w-container px-[6vw] py-24 max-md:py-16">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-12 text-center max-md:gap-10">
      <p class="text-base leading-relaxed text-dark-gray max-md:text-[0.95rem]">
        A weboldal a Demján Sándor Program keretében és támogatásával valósult
        meg.
      </p>

      <div
        class="flex flex-wrap items-center justify-center gap-x-20 gap-y-10 max-md:gap-x-12 max-md:gap-y-8"
      >
        <img
          src={dspLogoSrc}
          alt="Demján Sándor Program — www.dsprogram.hu"
          width="300"
          height="120"
          class="h-auto w-[300px] max-w-full object-contain"
          loading="lazy"
          decoding="async"
        />
        <img
          src={neumLogoSrc}
          alt="Neumann János Nonprofit Kft."
          width="300"
          height="100"
          class="h-auto w-[300px] max-w-full object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
