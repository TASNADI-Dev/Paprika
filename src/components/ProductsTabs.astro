---
import { asset } from '../lib/assets';
import {
  getProductTabDefaultBody,
  getProductTabs,
  type ProductTabField,
} from '../lib/productTabs';
import { t, type Locale } from '../lib/i18n';
import { urlFor } from '../lib/sanityImage';

interface CategoryImage {
  _key?: string;
  asset?: { _ref?: string; _id?: string } | null;
  alt?: string | null;
  hotspot?: unknown;
  crop?: unknown;
}

interface CategoryContent {
  body?: string | null;
  images?: CategoryImage[] | null;
}

type Categories = Partial<Record<ProductTabField, CategoryContent | null>>;

interface Props {
  locale?: Locale;
  categories?: Categories | null;
}

const { locale = 'en', categories } = Astro.props;
const dividerSrc = asset('/global/custom-divider.svg');

const tabs = getProductTabs(locale).map((tab) => {
  const content = categories?.[tab.field];
  return {
    ...tab,
    body: content?.body?.trim() || getProductTabDefaultBody(locale, tab.field),
    images: (content?.images ?? []).filter((image) => image?.asset),
  };
});
---

<section class="bg-white" aria-label={t(locale, 'products.title')} data-products-tabs>
  <div class="mx-auto max-w-container px-[6vw] pb-24 pt-16 max-md:pb-16 max-md:pt-12" data-stagger-children>
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <img
        src={dividerSrc}
        alt=""
        width="88"
        height="4"
        class="mb-2 h-1 w-[88px]"
        loading="eager"
        decoding="async"
      />
      <h1
        class="font-heading text-[3.75rem] font-medium leading-[1.2] tracking-tight text-dark-gray max-md:text-[3rem]"
      >
        {t(locale, 'products.title')}
      </h1>
    </div>

    <div class="mt-10 products-tabs:mt-12">
      <div class="relative products-tabs:hidden">
        <label for="products-category-select" class="sr-only">
          {t(locale, 'products.categoryAria')}
        </label>
        <select
          id="products-category-select"
          data-products-select
          class="w-full appearance-none rounded-lg border border-mid-gray-1 bg-white px-4 py-3 pr-10 text-base text-dark-gray"
        >
          {
            tabs.map((tab) => (
              <option value={tab.id}>{tab.label}</option>
            ))
          }
        </select>
        <i
          class="ph ph-caret-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-lg text-mid-gray-2"
          aria-hidden="true"
        ></i>
      </div>

      <div
        role="tablist"
        aria-label={t(locale, 'products.categoriesAria')}
        class="hidden w-full products-tabs:flex"
      >
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              data-tab-id={tab.id}
              aria-controls={`panel-${tab.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              class="products-tab flex-1 cursor-pointer border-b-2 border-mid-gray-1 pb-2 text-center text-base text-dark-gray/50 transition-colors duration-300 hover:text-blue aria-selected:border-blue aria-selected:text-blue"
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      tabs.map((tab, index) => (
        <div
          role="tabpanel"
          id={`panel-${tab.id}`}
          data-panel-id={tab.id}
          aria-labelledby={`tab-${tab.id}`}
          hidden={index !== 0}
          class="mt-10 max-md:mt-8"
        >
          <p class="w-full text-base leading-relaxed text-mid-gray-2 max-md:text-[0.95rem]">
            {tab.body}
          </p>

          {tab.images.length > 0 && (
            <div class="products-gallery mt-10 max-md:mt-8">
              {tab.images.map((image) => {
                const src = urlFor(image).width(900).quality(80).auto('format').url();
                const alt = image.alt || tab.label;
                return (
                  <img
                    src={src}
                    alt={alt}
                    width="600"
                    height="800"
                    class="mb-4 w-full break-inside-avoid rounded-lg"
                    loading="lazy"
                    decoding="async"
                  />
                );
              })}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .products-gallery {
    column-count: 3;
    column-gap: 1rem;
  }

  @media (max-width: 1023px) {
    .products-gallery {
      column-count: 2;
    }
  }

  @media (max-width: 639px) {
    .products-gallery {
      column-count: 1;
    }
  }
</style>

<script>
  import '../scripts/productsTabs.ts';
</script>
