---
import { asset } from '../../lib/assets';

interface ContactItem {
  _key?: string;
  icon?: string | null;
  text?: string | null;
  href?: string | null;
}

interface Props {
  slogan?: string | null;
  contactItems?: ContactItem[] | null;
}

const ICON_COLORS = ['text-blue', 'text-red', 'text-green'] as const;

const DEFAULT_SLOGAN =
  'Because the best retail experiences always need a little spice.';

const DEFAULT_CONTACT_ITEMS: ContactItem[] = [
  {
    _key: 'address',
    icon: 'ph ph-map-pin',
    text: 'Hungary, 1103 Budapest, Gyömrői út 150.',
    href: 'https://maps.app.goo.gl/6jy2A5eTwPxXWqVD9',
  },
  {
    _key: 'phone',
    icon: 'ph ph-phone',
    text: '+36 70 341 8874',
    href: 'tel:+36703418874',
  },
  {
    _key: 'email',
    icon: 'ph ph-envelope',
    text: 'info@paprika-advertising.com',
    href: 'mailto:info@paprika-advertising.com',
  },
];

const social = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/PaprikaAdvertisingkft',
    viewBox: '0 0 24 24',
    paths: [
      'M13.397 20.997v-8.196h2.765l.411-3.209h-3.176V7.548c0-.926.258-1.56 1.587-1.56h1.684V3.127A22.336 22.336 0 0 0 14.201 3c-2.444 0-4.122 1.492-4.122 4.231v2.355H7.332v3.209h2.753v8.202h3.312z',
    ],
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/paprika-advertising/',
    viewBox: '0 0 25 24',
    paths: [
      'M20.4702 3H4.47021C4.205 3 3.95064 3.10536 3.76311 3.29289C3.57557 3.48043 3.47021 3.73478 3.47021 4V20C3.47021 20.2652 3.57557 20.5196 3.76311 20.7071C3.95064 20.8946 4.205 21 4.47021 21H20.4702C20.7354 21 20.9898 20.8946 21.1773 20.7071C21.3649 20.5196 21.4702 20.2652 21.4702 20V4C21.4702 3.73478 21.3649 3.48043 21.1773 3.29289C20.9898 3.10536 20.7354 3 20.4702 3ZM8.80921 18.337H6.13721V9.747H8.80921V18.337ZM7.47321 8.574C7.06266 8.574 6.66892 8.41091 6.37861 8.1206C6.08831 7.8303 5.92521 7.43655 5.92521 7.026C5.92521 6.61544 6.08831 6.22171 6.37861 5.9314C6.66892 5.64109 7.06266 5.478 7.47321 5.478C7.88377 5.478 8.27751 5.64109 8.56782 5.9314C8.85812 6.22171 9.02121 6.61544 9.02121 7.026C9.02121 7.43655 8.85812 7.8303 8.56782 8.1206C8.27751 8.41091 7.88377 8.574 7.47321 8.574ZM18.8082 18.337H16.1392V14.16C16.1392 13.164 16.1212 11.883 14.7512 11.883C13.3612 11.883 13.1502 12.969 13.1502 14.09V18.338H10.4832V9.748H13.0432V10.922H13.0802C13.4352 10.247 14.3072 9.535 15.6042 9.535C18.3082 9.535 18.8072 11.313 18.8072 13.627L18.8082 18.337Z',
    ],
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/paprika_advertising/',
    viewBox: '0 0 32 32',
    paths: [
      'M16 9.838A6.162 6.162 0 1 0 22.162 16A6.16 6.16 0 0 0 16 9.838M16 20a4 4 0 1 1 4-4a4 4 0 0 1-4 4',
      'M16 6.162c3.204 0 3.584.012 4.849.07a6.6 6.6 0 0 1 2.228.413a3.98 3.98 0 0 1 2.278 2.278a6.6 6.6 0 0 1 .413 2.228c.058 1.265.07 1.645.07 4.85s-.012 3.583-.07 4.848a6.6 6.6 0 0 1-.413 2.228a3.98 3.98 0 0 1-2.278 2.278a6.6 6.6 0 0 1-2.228.413c-1.265.058-1.645.07-4.849.07s-3.584-.012-4.849-.07a6.6 6.6 0 0 1-2.228-.413a3.98 3.98 0 0 1-2.278-2.278a6.6 6.6 0 0 1-.413-2.228c-.058-1.265-.07-1.645-.07-4.849s.012-3.584.07-4.849a6.6 6.6 0 0 1 .413-2.228a3.98 3.98 0 0 1 2.278-2.278a6.6 6.6 0 0 1 2.228-.413c1.265-.058 1.645-.07 4.849-.07M16 4c-3.259 0-3.668.014-4.948.072a8.8 8.8 0 0 0-2.912.558a6.14 6.14 0 0 0-3.51 3.51a8.8 8.8 0 0 0-.558 2.913C4.014 12.333 4 12.74 4 16s.014 3.668.072 4.948a8.8 8.8 0 0 0 .558 2.912a6.14 6.14 0 0 0 3.51 3.51a8.8 8.8 0 0 0 2.913.558c1.28.058 1.688.072 4.947.072s3.668-.014 4.948-.072a8.8 8.8 0 0 0 2.913-.558a6.14 6.14 0 0 0 3.51-3.51a8.8 8.8 0 0 0 .557-2.913C27.986 19.667 28 19.26 28 16s-.014-3.668-.072-4.948a8.8 8.8 0 0 0-.558-2.912a6.14 6.14 0 0 0-3.51-3.51a8.8 8.8 0 0 0-2.913-.557C19.667 4.013 19.26 4 16 4',
    ],
    dot: { cx: 22.406, cy: 9.594, r: 1.44 },
  },
] as const;

const { slogan, contactItems } = Astro.props;

const year = new Date().getFullYear();
const tagline = slogan || DEFAULT_SLOGAN;
const items = contactItems?.length ? contactItems : DEFAULT_CONTACT_ITEMS;
---

<footer class="border-t border-mid-gray-1 bg-white text-mid-dark">
  <div class="mx-auto max-w-container px-[6vw] py-12 max-md:py-10">
    <div
      class="flex items-start justify-between gap-10 max-lg:flex-col max-lg:gap-8"
    >
      <div class="max-w-md">
        <a href="/" class="inline-block leading-none" aria-label="Paprika Advertising home">
          <img
            src={asset('/global/logo.webp')}
            alt="Paprika Advertising"
            width="182"
            height="48"
            class="h-auto w-[7.5rem]"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-4 text-base leading-relaxed text-mid-gray-2">
          {tagline}
        </p>
      </div>

      <ul class="flex flex-col gap-3" role="list">
        {
          items.map((item, index) => {
            const colorClass = ICON_COLORS[index % ICON_COLORS.length];
            const isExternal = Boolean(item.href?.startsWith('http'));

            return (
              <li class="flex items-start gap-3">
                {item.href ? (
                  <a
                    href={item.href}
                    class="flex items-start gap-3 text-base transition-colors duration-300 hover:text-blue"
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                  >
                    {item.icon && (
                      <i
                        class:list={[item.icon, colorClass, 'mt-0.5 shrink-0 text-lg']}
                        aria-hidden="true"
                      />
                    )}
                    <span class="underline underline-offset-2">{item.text}</span>
                  </a>
                ) : (
                  <>
                    {item.icon && (
                      <i
                        class:list={[item.icon, colorClass, 'mt-0.5 shrink-0 text-lg']}
                        aria-hidden="true"
                      />
                    )}
                    <span class="underline underline-offset-2">{item.text}</span>
                  </>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="my-8 h-px w-full bg-mid-gray-1 max-md:my-6"></div>

    <div
      class="flex items-center justify-between gap-6 text-sm max-lg:flex-col max-lg:items-start max-lg:gap-5"
    >
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-mid-dark">
        <p>
          All rights reserved. © Copyright {year} Paprika Advertising
        </p>
        <a
          href="/privacy-policy"
          class="underline underline-offset-2 transition-colors duration-300 hover:text-blue"
        >
          Privacy Policy
        </a>
        <button
          type="button"
          class="cky-banner-element cursor-pointer border-0 bg-transparent p-0 underline underline-offset-2 transition-colors duration-300 hover:text-blue"
        >
          Cookie settings
        </button>
        <p>
          Design by{' '}
          <a
            href="https://www.tasnadi.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 transition-colors duration-300 hover:text-blue"
          >
            Tasnadi
          </a>
        </p>
      </div>

      <ul class="flex items-center gap-4" role="list" aria-label="Social media">
        {
          social.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="block h-5 w-5 text-mid-dark transition-colors duration-300 hover:text-blue"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox={item.viewBox}
                  class="h-full w-full"
                  aria-hidden="true"
                  fill="currentColor"
                >
                  {'dot' in item && item.dot && (
                    <circle cx={item.dot.cx} cy={item.dot.cy} r={item.dot.r} />
                  )}
                  {item.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
