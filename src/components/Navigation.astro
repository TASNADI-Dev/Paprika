---
import Button from './Button.astro';
import { asset } from '../lib/assets';
import {
  localizedPath,
  switchLocalePath,
  t,
  type Locale,
} from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const currentPath = Astro.url.pathname;

const links = [
  { label: t(locale, 'nav.products'), href: localizedPath(locale, '/products') },
  { label: t(locale, 'nav.aboutUs'), href: localizedPath(locale, '/about-us') },
];

const enHref = switchLocalePath(currentPath, 'en');
const frHref = switchLocalePath(currentPath, 'fr');
const quoteHref = `${localizedPath(locale, '/')}#quote`;
const homeHref = localizedPath(locale, '/');
---

<header
  data-nav
  data-nav-open="false"
  class="sticky top-0 z-50 border-b border-mid-gray-1 bg-white text-mid-dark"
>
  <div
    class="mx-auto flex max-w-container items-center justify-between gap-4 px-[6vw] py-2.5 lg:gap-8"
  >
    <a href={homeHref} class="shrink-0 leading-none" aria-label={t(locale, 'nav.homeAria')}>
      <img
        src={asset('/global/logo.webp')}
        alt={t(locale, 'nav.logoAlt')}
        width="182"
        height="48"
        class="h-auto w-[7.5rem]"
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="flex items-center gap-3 lg:gap-6">
      <nav class="hidden items-center gap-1 lg:flex" aria-label={t(locale, 'nav.primaryAria')}>
        {
          links.map((link) => (
            <a
              href={link.href}
              class="px-3 py-2 text-base text-mid-dark transition-colors duration-300 hover:text-blue"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <Button href={quoteHref} label={t(locale, 'nav.requestQuote')} />
      <div class="hidden items-center gap-2 text-sm lg:flex" aria-label={t(locale, 'nav.languageAria')}>
        <a
          href={enHref}
          class:list={[
            'transition-colors duration-300 hover:text-blue',
            locale === 'en' && 'underline',
          ]}
          hreflang="en"
          {...locale === 'en' ? { 'aria-current': 'true' } : {}}
        >
          EN
        </a>
        <a
          href={frHref}
          class:list={[
            'transition-colors duration-300 hover:text-blue',
            locale === 'fr' && 'underline',
          ]}
          hreflang="fr"
          {...locale === 'fr' ? { 'aria-current': 'true' } : {}}
        >
          FR
        </a>
      </div>

      <button
        type="button"
        data-nav-toggle
        data-open-label={t(locale, 'nav.openMenu')}
        data-close-label={t(locale, 'nav.closeMenu')}
        class="relative flex h-10 w-10 items-center justify-center lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(locale, 'nav.openMenu')}
      >
        <span class="sr-only">{t(locale, 'nav.menu')}</span>
        <span class="relative block h-[17px] w-6" aria-hidden="true">
          <span
            data-nav-bar="top"
            class="absolute left-0 top-0 block h-px w-full origin-center bg-mid-dark"
          ></span>
          <span
            data-nav-bar="middle"
            class="absolute left-0 top-[8px] block h-px w-full origin-center bg-mid-dark"
          ></span>
          <span
            data-nav-bar="bottom"
            class="absolute left-0 bottom-0 block h-px w-full origin-center bg-mid-dark"
          ></span>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    data-nav-panel
    hidden
    class="absolute inset-x-0 top-full h-[calc(100svh-100%)] overflow-y-auto bg-white lg:hidden"
  >
    <nav
      class="mx-auto flex max-w-container flex-col gap-6 px-[6vw] py-10"
      aria-label={t(locale, 'nav.mobileAria')}
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-xl text-mid-dark transition-colors duration-300 hover:text-blue"
          >
            {link.label}
          </a>
        ))
      }

      <div class="flex items-center gap-3 pt-2 text-xl" aria-label={t(locale, 'nav.languageAria')}>
        <a
          href={enHref}
          class:list={[
            'transition-colors duration-300 hover:text-blue',
            locale === 'en' && 'underline',
          ]}
          hreflang="en"
          {...locale === 'en' ? { 'aria-current': 'true' } : {}}
        >
          EN
        </a>
        <a
          href={frHref}
          class:list={[
            'transition-colors duration-300 hover:text-blue',
            locale === 'fr' && 'underline',
          ]}
          hreflang="fr"
          {...locale === 'fr' ? { 'aria-current': 'true' } : {}}
        >
          FR
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import '../scripts/navigation.ts';
</script>
