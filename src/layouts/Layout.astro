---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { asset } from '../lib/assets';
import { fetchFooter } from '../lib/queries';
import {
  DEFAULT_LOCALE,
  getAlternateHref,
  getLocaleFromUrl,
  LOCALES,
  type Locale,
} from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { title = 'Paprika', description, locale: localeProp } = Astro.props;
const locale = localeProp ?? getLocaleFromUrl(Astro.url);
const site = Astro.site ?? Astro.url;
const footer = await fetchFooter(locale);

const alternateLinks = LOCALES.map((alternateLocale) => ({
  hreflang: alternateLocale,
  href: getAlternateHref(site, Astro.url.pathname, alternateLocale),
}));
const defaultHref = getAlternateHref(site, Astro.url.pathname, DEFAULT_LOCALE);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={asset('/global/favicon.png')} />
    <link
      rel="stylesheet"
      href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css"
    />
    <link
      rel="stylesheet"
      href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {
      alternateLinks.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <title>{title}</title>
  </head>
  <body class="bg-light-gray font-sans text-dark-gray antialiased">
    <Navigation locale={locale} />
    <slot />
    <Footer locale={locale} slogan={footer?.slogan} contactItems={footer?.contactItems} />
    <script>
      import '../scripts/smoothScroll.ts';
      import '../scripts/staggerChildren.ts';
    </script>
  </body>
</html>
